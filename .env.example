# Environment variables for car-rental
# Copy to `.env` and fill in real values: cp .env.example .env

# MongoDB connection string (required). Use a MongoDB Atlas cluster in
# production, or a local mongod for development.
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional database name (default: car-rental)
MONGODB_DB=car-rental

# JWT secret (required, minimum 16 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-here-min-16-chars

# Server port (optional, default 3000)
PORT=3000

# Node environment (optional: development, production)
NODE_ENV=development

# ─── LINE notifications for drivers (optional) ───
# LINE Developers → Messaging API channel. Leave empty to turn the feature off.
# Webhook URL: https://<your-domain>/api/line/webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Basic ID of the Official Account, e.g. @123abcde
LINE_BOT_ID=
# Public URL of this site, used for links inside LINE messages
APP_URL=
# Hour (0-23) the evening-before reminders start; "off" disables them
DRIVER_REMINDER_HOUR=17
