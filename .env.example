[TEMPLATE]
# Copy to .env and fill in real values.
# The API, `npm run seed` and the npm scripts load this file automatically.
# Real environment variables always win over the file.
#
# JWT_SECRET is REQUIRED in production (set NODE_ENV=production / Vercel).
# Use a long random string, e.g. `openssl rand -hex 32`. Minimum 16 characters.
JWT_SECRET=

# ── Database (SQLite via sql.js) ────────────────────────────────────────────
# Location of the database file (default: <project>/data.sqlite).
# The whole file is rewritten after every write, so it needs a *persistent*
# filesystem. On Vercel the only writable path is /tmp, which is ephemeral and
# per-instance — data there is lost on every cold start.
# SQLITE_PATH=

# ── Server ──────────────────────────────────────────────────────────────────
# Backend port for `npm run dev:server` (optional, defaults to 3000)
# PORT=3000

# ── Real-time (SSE) ─────────────────────────────────────────────────────────
# How often an open stream re-checks its token against the database (ms).
# SSE_REVALIDATE_MS=15000
# Keep-alive comment interval on open streams (ms).
# SSE_KEEPALIVE_MS=30000
