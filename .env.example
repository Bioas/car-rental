# Environment variables for car-rental
# Copy to `.env` and fill in real values: cp .env.example .env

# MongoDB connection string (required). Use a MongoDB Atlas cluster in
# production, or a local mongod for development.
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional database name (default: car-rental)
MONGODB_DB=car-rental

# JWT secret (required, minimum 16 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-here-min-16-chars

# Server port (optional, default 3000)
PORT=3000

# Node environment (optional: development, production)
NODE_ENV=development
